<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <linearGradient id="bg5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fdf4ff" />
      <stop offset="100%" stop-color="#f5d0fe" />
    </linearGradient>
    <filter id="sh5" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.08" />
    </filter>
  </defs>
  <rect width="600" height="400" fill="url(#bg5)" rx="16" />
  <circle cx="90" cy="70" r="55" fill="white" fill-opacity="0.4" />
  <circle cx="510" cy="90" r="70" fill="white" fill-opacity="0.3" />
  <g transform="translate(150, 45)" filter="url(#sh5)">
    <rect width="300" height="200" rx="20" fill="white" fill-opacity="0.95" />
    <circle cx="150" cy="80" r="42" fill="#a855f7" fill-opacity="0.15" />
    <text x="150" y="115" font-size="64" text-anchor="middle">😋</text>
  </g>
  <g transform="translate(300, 290)" text-anchor="middle">
    <text font-family="'Noto Serif SC', 'Songti SC', serif" font-weight="bold" font-size="28" fill="#0f172a" y="0">苹果又甜又好吃，他真开心！</text>
    <text font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="17" font-weight="600" fill="#a855f7" y="32">Píngguǒ yòu tián yòu hǎochī, tā zhēn kāixīn!</text>
    <text font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="15" fill="#64748b" y="60">The apples are sweet and delicious, he is really happy!</text>
  </g>
</svg>