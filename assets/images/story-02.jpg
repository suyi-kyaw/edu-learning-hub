<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#e0f2fe" />
      <stop offset="100%" stop-color="#bae6fd" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.08" />
    </filter>
  </defs>
  <rect width="600" height="400" fill="url(#bg)" rx="16" />
  
  <!-- Subtle decorative circles -->
  <circle cx="80" cy="70" r="60" fill="white" fill-opacity="0.35" />
  <circle cx="520" cy="90" r="80" fill="white" fill-opacity="0.25" />
  
  <!-- Central illustration frame -->
  <g transform="translate(150, 45)" filter="url(#shadow)">
    <rect width="300" height="200" rx="20" fill="white" fill-opacity="0.9" />
    <circle cx="150" cy="80" r="42" fill="#0284c7" fill-opacity="0.2" />
    <text x="150" y="115" font-size="64" text-anchor="middle">⏰</text>
  </g>
  
  <!-- Text Label Badge -->
  <g transform="translate(300, 290)" text-anchor="middle">
    <text font-family="'Noto Serif SC', 'Songti SC', serif" font-weight="bold" font-size="32" fill="#1e293b" y="0">小明起床了。</text>
    <text font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="18" font-weight="600" fill="#ea580c" y="32">Xiǎomíng qǐchuáng le.</text>
    <text font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="16" fill="#64748b" y="60">Xiaoming gets up.</text>
  </g>
</svg>