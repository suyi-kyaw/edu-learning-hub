# Optional stable secret used to sign LinguaPath session tokens (HMAC-SHA256).
# If omitted, the Node server auto-generates and persists a random secret in data/auth-secret.json.
AUTH_TOKEN_SECRET=

# Outbound SMTP settings for "Forgot Password" email delivery (temporary password generation)
# Example for Gmail App Password: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LinguaPath <no-reply@example.com>
